<Window x:Class="g1_hangmanhero.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hangman Hero - Welcome" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                  Text="Welcome to Hangman Hero" 
                  FontSize="36" 
                  FontWeight="Bold" 
                  HorizontalAlignment="Center" 
                  Margin="0,20,0,20"
                  Foreground="#2E7D32"/>

        <!-- Main Content -->
        <StackPanel Grid.Row="1" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Orientation="Vertical">
            <Button Content="Register" 
                    Command="{Binding NavigateToRegisterCommand}"
                    Width="200" 
                    Height="50" 
                    Margin="0,10"
                    FontSize="16"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Start Game" 
                    Command="{Binding StartGameCommand}"
                    Width="200" 
                    Height="50" 
                    Margin="0,10"
                    FontSize="16"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="2" 
                  Text="© 2025 Hangman Hero" 
                  HorizontalAlignment="Center" 
                  Margin="0,0,0,10"
                  Foreground="#757575"/>
    </Grid>
</Window>