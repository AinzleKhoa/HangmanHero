<Window x:Class="g1_hangmanhero.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:g1_hangmanhero.ViewModels"
        mc:Ignorable="d"
        Title="Hangman Hero - Main Menu" Height="556" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F0F0F0">
        <StackPanel VerticalAlignment="Center" Margin="40">
            <TextBlock Text="Hangman Hero" FontSize="36" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,40" Foreground="Green"/>

            <Button Content="Start Game" 
                    Command="{Binding NavigateToGameSetupCommand}" 
                    Margin="0,5" Padding="15" FontSize="18"/>

            <Button Content="Your Game History" 
                    Command="{Binding NavigateToHistoryCommand}" 
                    Margin="0,5" Padding="15" FontSize="18"/>

            <Button Content="Scoreboard" 
                    Command="{Binding NavigateToScoreboardCommand}" 
                    Margin="0,5" Padding="15" FontSize="18"/>

            <Button Content="Exit" 
                    Command="{Binding ExitApplicationCommand}" 
                    Margin="0,20,0,0" Padding="15" FontSize="18" Background="#DC3545" Foreground="White"/>
            
            <Button Content="Logout"
                    Width="50"
                    Height="30"
                    Margin="0,20,0,0"
                    FontWeight="Bold"
                    Background="Gray"
                    Foreground="White" Click="Logout_click"
                    />
        </StackPanel>
    </Grid>
</Window>