<!-- RegisterView.xaml -->
<Window x:Class="g1_hangmanhero.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register" Height="300" Width="300">
    <StackPanel Margin="20">
        <!-- Username TextBox -->
        <TextBlock Text="Enter your username" Foreground="Gray" Margin="0 5" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Username}" Margin="0 5" Height="30"/>

        <!-- PasswordBox for password input -->
        <TextBlock Text="Enter your password" Foreground="Gray" Margin="0 5" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox" Margin="0 5" Height="30"/>

        <!-- Confirm PasswordBox for confirmation -->
        <TextBlock Text="Confirm your password" Foreground="Gray" Margin="0 5" VerticalAlignment="Center"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Margin="0 5" Height="30"/>

        <Button Content="Register" Command="{Binding RegisterCommand}" Margin="0 10"/>
    </StackPanel>
</Window>
